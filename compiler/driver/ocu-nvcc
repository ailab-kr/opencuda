def _module_dir() -> Path:
    """Where ocu_cc.py lives: compiler/probe in the source tree,
    <prefix>/libexec/ocu when installed."""
    for d in (os.environ.get("OCU_LIBEXEC"), REAL.parent.parent / "probe",
              REAL.parent.parent / "libexec" / "ocu"):
        if d and (Path(d) / "ocu_cc.py").is_file():
            return Path(d)
    sys.exit(f"{PROG}: cannot find ocu_cc.py (set OCU_LIBEXEC)")


