# Command-line behaviour of ocu_cc.py --ptx-shift (card compiler-ptx-shift).
#   -DPY=<python> -DCC=<ocu_cc.py> -DCXX=<c++> -DCC_COMPILER=<cc> -DDIR=<tests/compiler/ptx_shift>
#   -DOUT=<object> -DTARGET=cpu|nvidia -DMODE=...
# MODE
#   warn      -DCASE=<n> -DEXPECT=warn|quiet|error  (cases/ptx_shift_cases.cu)
#             warn:  exit 0, exactly one "ocu_cc: --ptx-shift: <file>:<line>:" line, naming the
#                    file and line of the MARK<n> comment (-DMARK_FILE=<name under cases/ or outside/>)
#             quiet: exit 0, no such line
#             error: exit 1 (Clang cannot read the source: out-of-range constant expression)
#             The sources are never modified.
#   print     --print-commands with and without the option (the step only with it)
#   unsupported  -DARGS=<ocu_cc arguments, ; separated>: exit 2, no output file, message names --ptx-shift
foreach(v PY CC DIR OUT TGT MODE)
  if(NOT DEFINED ${v})
    message(FATAL_ERROR "ptx_shift_cmd.cmake: -D${v}= is required")
  endif()
endforeach()
file(REMOVE ${OUT})

set(arch_args)
if(TGT STREQUAL "nvidia")
  set(arch_args --arch sm_80)
endif()
set(env_cmd ${CMAKE_COMMAND} -E env CXX=${CXX} CC=${CC_COMPILER})
set(src ${DIR}/cases/ptx_shift_cases.cu)

function(hash_tree out)
  file(GLOB_RECURSE files ${DIR}/*.cu ${DIR}/*.h)
  list(SORT files)
  set(all "")
  foreach(f IN LISTS files)
    file(SHA256 ${f} h)
    string(APPEND all "${f}=${h};")
  endforeach()
  set(${out} "${all}" PARENT_SCOPE)
endfunction()

if(MODE STREQUAL "warn")
  hash_tree(before)
  set(opt --ptx-shift)
  if(DEFINED NO_OPTION)
    set(opt)
  endif()
  execute_process(
    COMMAND ${env_cmd} ${PY} ${CC} --target ${TGT} ${arch_args} -O1 -D CASE=${CASE}
            -I ${DIR}/outside ${opt} -c ${src} -o ${OUT}
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  message("exit: ${rc}\n${out}\n${err}")
  hash_tree(after)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "ocu_cc modified a source file (it must work on copies)")
  endif()
  string(REGEX MATCHALL "ocu_cc: --ptx-shift: [^\n]*" notes "${err}")
  list(LENGTH notes n_notes)
  if(EXPECT STREQUAL "error")
    if(NOT rc EQUAL 1)
      message(FATAL_ERROR "expected exit code 1 (Clang failed on the unmodified source), got ${rc}")
    endif()
    if(EXISTS ${OUT})
      message(FATAL_ERROR "an output file was written although the step failed")
    endif()
    return()
  endif()
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "case ${CASE} (${TGT}) must compile (the shift stays as written), exit ${rc}")
  endif()
  if(NOT EXISTS ${OUT})
    message(FATAL_ERROR "no output file")
  endif()
  if(EXPECT STREQUAL "quiet")
    if(n_notes GREATER 0)
      message(FATAL_ERROR "case ${CASE}: nothing may be reported, got: ${notes}")
    endif()
    return()
  endif()
  if(NOT n_notes EQUAL 1)
    message(FATAL_ERROR "case ${CASE}: expected exactly one report, got ${n_notes}: ${notes}")
  endif()
  # The line of the MARK<n> comment in MARK_FILE.
  if(EXISTS ${DIR}/cases/${MARK_FILE})
    set(mf ${DIR}/cases/${MARK_FILE})
  else()
    set(mf ${DIR}/outside/${MARK_FILE})
  endif()
  execute_process(
    COMMAND ${PY} -I -c "import sys; t=open(sys.argv[1],encoding='utf-8').read().split('\\n'); print(next(i+1 for i,l in enumerate(t) if sys.argv[2] in l))" ${mf} MARK${CASE}
    OUTPUT_VARIABLE line OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE prc)
  if(NOT prc EQUAL 0)
    message(FATAL_ERROR "no MARK${CASE} in ${mf}")
  endif()
  if(NOT notes MATCHES "${MARK_FILE}:${line}:")
    message(FATAL_ERROR "case ${CASE}: the report must name ${MARK_FILE}:${line}, got: ${notes}")
  endif()
elseif(MODE STREQUAL "print")
  execute_process(
    COMMAND ${env_cmd} ${PY} ${CC} --target ${TGT} ${arch_args} --print-commands -c ${src} -o ${OUT}
    RESULT_VARIABLE rc OUTPUT_VARIABLE plain ERROR_VARIABLE err1)
  execute_process(
    COMMAND ${env_cmd} ${PY} ${CC} --target ${TGT} ${arch_args} --print-commands --ptx-shift -c ${src} -o ${OUT}
    RESULT_VARIABLE rc2 OUTPUT_VARIABLE shifted ERROR_VARIABLE err2)
  if(NOT rc EQUAL 0 OR NOT rc2 EQUAL 0)
    message(FATAL_ERROR "--print-commands failed: ${rc} ${rc2}\n${err1}\n${err2}")
  endif()
  if(plain MATCHES "(<ptx-shift>|ocu_ptx_shift\.h)")
    message(FATAL_ERROR "without the option the commands mention ptx-shift:\n${plain}")
  endif()
  if(NOT shifted MATCHES "(<ptx-shift>|ocu_ptx_shift\.h)")
    message(FATAL_ERROR "with the option the commands do not mention ptx-shift:\n${shifted}")
  endif()
elseif(MODE STREQUAL "unsupported")
  string(REPLACE "|" ";" ARGS "${ARGS}")
  execute_process(
    COMMAND ${env_cmd} ${PY} ${CC} ${ARGS} --ptx-shift -c ${src} -o ${OUT}
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  message("exit: ${rc}\n${out}\n${err}")
  if(NOT rc EQUAL 2)
    message(FATAL_ERROR "expected exit code 2 (not supported), got ${rc}")
  endif()
  if(EXISTS ${OUT})
    message(FATAL_ERROR "an output file was written although the option is not supported")
  endif()
  if(NOT err MATCHES "ptx-shift")
    message(FATAL_ERROR "the message must name the option: ${err}")
  endif()
else()
  message(FATAL_ERROR "unknown MODE ${MODE}")
endif()
